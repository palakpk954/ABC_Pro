# Environment Configuration for Allocate

# Cognitive AI & LLM Resource Manager (Groq - Free Open Source Llama 3.3 70B)
# Get a free key with zero credit card at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Backend Database
DATABASE_URL=postgresql://allocate_user:allocate_password@localhost:5432/allocate_db
# For testing or fallback without Postgres:
# DATABASE_URL=sqlite:///./allocate.db

# Authentication & Security
SECRET_KEY=super-secret-production-random-key-change-in-prod-allocate-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optimization Engine Defaults
SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_RANDOM_SEED=42
DEFAULT_MAX_CONCURRENT_PROJECTS=2
DEFAULT_MIN_BLOCK_HOURS=10
DEFAULT_MENTOR_TIME_RATIO=0.10

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
